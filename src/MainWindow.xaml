<Window x:Class="VgmDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VgmDesk · 游戏音轨工作台" Width="1130" Height="730" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#242030" Background="#F6F5F8" AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#242030"/>
    <SolidColorBrush x:Key="Muted" Color="#615970"/>
    <SolidColorBrush x:Key="Rule" Color="#E6E0EC"/>
    <SolidColorBrush x:Key="Accent" Color="#603B88"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#D9D0E4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="33"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#9A79B9"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.74"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="31"/><Setter Property="BorderBrush" Value="#D9D0E4"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="#F1EDF7"/><Setter Property="Foreground" Value="#51435F"/><Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAE0F5"/><Setter Property="Foreground" Value="#34204D"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#E1D2EF"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#261D32">
      <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Background="#48345F" CornerRadius="8" Margin="0,0,13,0"><Path Stroke="#DBC3FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,11 L4,11 7,4 11,18 15,1 19,14 22,9 26,9"/></Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="VgmDesk" Foreground="White" FontSize="25" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text="游戏音轨工作台" Foreground="#DAD1E5" Margin="15,5,0,0" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="EngineLabel" Text="正在检测解码器…" Foreground="#DDD0EE" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="EngineButton" Content="解码器设置" Background="#3B2D4A" Foreground="White" BorderBrush="#655278" Click="OnEngine"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,13,22,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="AddButton" Style="{StaticResource Primary}" Content="＋ 添加文件" Click="OnAdd" Margin="0,0,8,0" ToolTip="Ctrl+O"/>
        <Button x:Name="FolderButton" Content="添加文件夹" Click="OnFolder" Margin="0,0,8,0"/>
        <Button x:Name="RemoveButton" Content="移除所选" Click="OnRemove" Margin="0,0,8,0" ToolTip="Delete"/>
        <Button x:Name="ClearButton" Content="清空列表" Click="OnClear"/>
      </StackPanel>
      <Grid Grid.Column="1"><TextBox x:Name="SearchBox" TextChanged="OnSearch" Padding="10,4" AutomationProperties.Name="筛选文件"/><TextBlock x:Name="SearchHint" Text="筛选文件名或路径" IsHitTestVisible="False" Margin="11,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="22,0,22,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="TrackGrid" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEAF3" RowHeight="33" AlternationCount="2" AlternatingRowBackground="#FBF9FD" Background="White" BorderThickness="0" SelectionChanged="OnSelection" MouseDoubleClick="OnTrackDoubleClick" AutomationProperties.Name="音频队列">
            <DataGrid.Columns>
              <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="2*" MinWidth="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="80" SortMemberPath="Info.Duration"/>
              <DataGridTextColumn Header="声道" Binding="{Binding Channels}" Width="59" SortMemberPath="Info.Channels"/>
              <DataGridTextColumn Header="子音轨" Binding="{Binding Tracks}" Width="70" SortMemberPath="Info.Total"/>
              <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" MinWidth="85"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyCard" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,22,8,0">
            <Border Width="54" Height="49" CornerRadius="9" Background="#F1EDF7" Margin="0,0,0,11"><Path Width="27" Height="20" Stretch="Fill" Stroke="#603B88" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,10 L 5,10 8,4 12,17 15,1 19,13 22,7 26,7"/></Border>
            <TextBlock x:Name="EmptyTitle" Text="拖入游戏音频或文件夹" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" Text="也可以用「添加文件」选择多个文件。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="7">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,11">
            <TextBlock Text="音轨详情" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock x:Name="DetailName" Text="尚未选中文件" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Grid Margin="0,8,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="子音轨" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TrackNumber" Grid.Column="1" Text="1" IsEnabled="False" KeyDown="OnTrackNumberKey" AutomationProperties.Name="子音轨编号"/>
              <Button x:Name="TrackApply" Grid.Column="2" Content="查看" Margin="6,0,0,0" MinHeight="31" IsEnabled="False" Click="OnTrackApply"/>
            </Grid>
            <TextBlock x:Name="DetailSummary" Text="选中文件后查看编码、声道和循环点。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MinHeight="37"/>
            <TextBlock x:Name="LoopSummary" TextWrapping="Wrap" Foreground="#176B62" FontSize="12" Margin="0,3,0,0"/>
            <Border Height="1" Background="{StaticResource Rule}" Margin="0,10"/>
            <TextBlock Text="WAV 导出设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.42*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="循环处理" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LoopBox" AutomationProperties.Name="循环处理" SelectedIndex="0" SelectionChanged="OnLoopMode"><ComboBoxItem Content="完整播放一次"/><ComboBoxItem Content="循环后淡出"/><ComboBoxItem Content="循环后播放尾部"/><ComboBoxItem Content="写入循环点"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="采样格式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FormatBox" AutomationProperties.Name="采样格式" SelectedIndex="0"><ComboBoxItem Content="PCM 16-bit"/><ComboBoxItem Content="PCM 24-bit"/><ComboBoxItem Content="PCM 32-bit"/><ComboBoxItem Content="浮点 32-bit"/></ComboBox></StackPanel>
            </Grid>
            <Grid x:Name="LoopFields" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="循环次数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoopCount" Text="2" AutomationProperties.Name="循环次数"/></StackPanel>
              <StackPanel x:Name="FadeField" Grid.Column="2"><TextBlock Text="淡出（秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FadeTime" Text="10" AutomationProperties.Name="淡出秒数"/></StackPanel>
              <StackPanel x:Name="DelayField" Grid.Column="4"><TextBlock Text="延迟（秒）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FadeDelay" Text="0" AutomationProperties.Name="淡出延迟秒数"/></StackPanel>
            </Grid>
            <TextBlock Text="输出文件夹" Style="{StaticResource FieldLabel}" Margin="0,8,0,5"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="浏览" Click="OnOutputFolder" Margin="6,0,0,0" MinHeight="31"/><TextBox x:Name="OutputBox" AutomationProperties.Name="输出文件夹" ToolTip="可粘贴绝对路径"/></DockPanel>
            <CheckBox x:Name="AllSubsongs" Content="导出全部子音轨" IsChecked="True" Margin="0,8,0,0" ToolTip="关闭后仅导出各文件当前选中的子音轨"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ExportSelected" Style="{StaticResource Primary}" Content="导出所选" Click="OnExportSelected"/><Button x:Name="ExportAll" Grid.Column="2" Content="导出全部" Click="OnExportAll" ToolTip="导出整个队列中可解码的文件，包括筛选隐藏的文件"/></Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#F0EBF7" BorderBrush="#E6DDED" BorderThickness="0,1,0,1">
      <Grid Margin="22,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="PlayButton" Content="▶ 试听" Style="{StaticResource Primary}" Click="OnPlay" MinWidth="81" Margin="0,0,7,0"/>
        <Button x:Name="StopButton" Grid.Column="1" Content="■ 停止" Click="OnStop" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock x:Name="PlayingName" Text="未播放" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayingHint" Text="试听按原始音轨播放一次" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        <Slider x:Name="Position" Grid.Column="3" Minimum="0" Maximum="1" VerticalAlignment="Center" IsEnabled="False" IsMoveToPointEnabled="True" ValueChanged="OnSeek" AutomationProperties.Name="试听进度"/>
        <TextBlock x:Name="TimeLabel" Grid.Column="4" Text="0:00 / 0:00" FontFamily="Segoe UI" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,16,0"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="音量" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="Volume" Width="75" Minimum="0" Maximum="1" Value="0.7" Margin="7,0,0,0" VerticalAlignment="Center" ValueChanged="OnVolume" AutomationProperties.Name="试听音量"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="22,5,22,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CountLabel" Text="0 个文件" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,13,0"/>
      <TextBlock Grid.Column="1" x:Name="StatusLabel" Text="就绪" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <ProgressBar x:Name="JobProgress" Grid.Column="2" Width="108" Height="5" Visibility="Collapsed" Margin="10,0" Foreground="{StaticResource Accent}"/>
      <Button x:Name="CancelButton" Grid.Column="3" Content="取消任务" Click="OnCancel" Visibility="Collapsed" MinHeight="25" Padding="8,1" FontSize="11"/>
      <Button x:Name="LogButton" Grid.Column="4" Content="任务日志" Click="OnLog" Margin="7,0,0,0" MinHeight="25" Padding="8,1" FontSize="11"/>
    </Grid>
  </Grid>
</Window>
